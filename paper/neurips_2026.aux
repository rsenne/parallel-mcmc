\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Scaling in latent dimension $D$ (top) and particle count $N$ (bottom). With diagonal-Hutchinson Jacobians, independent dimensions stay at the $2$-iteration floor (top right) and degrade gracefully; coupled dimensions hit $6$--$7$ iterations and parallel runtime crosses sequential near $D=16$. Particle-count scaling is benign: speedup decays smoothly with $N$ while RMSE shrinks as $N^{-1/2}$ (bottom right).}}{8}{figure.2}}
\newlabel{fig:scaling-DN}{{2}{8}{Scaling in latent dimension $D$ (top) and particle count $N$ (bottom). With diagonal-Hutchinson Jacobians, independent dimensions stay at the $2$-iteration floor (top right) and degrade gracefully; coupled dimensions hit $6$--$7$ iterations and parallel runtime crosses sequential near $D=16$. Particle-count scaling is benign: speedup decays smoothly with $N$ while RMSE shrinks as $N^{-1/2}$ (bottom right)}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Twist-quality ablation on LGSSM ($T=4096, N=256$). All four twists hit DEER's $2$-iteration floor (left) with comparable wall-clock speedup (middle), but their statistical quality (right) varies by more than an order of magnitude: a wide prior twist yields RMSE $1.37$ vs.\ $0.04$ for a backward-information-filter twist. Parallelism is essentially free; twist quality is the bottleneck.}}{8}{figure.3}}
\newlabel{fig:twist-ablation}{{3}{8}{Twist-quality ablation on LGSSM ($T=4096, N=256$). All four twists hit DEER's $2$-iteration floor (left) with comparable wall-clock speedup (middle), but their statistical quality (right) varies by more than an order of magnitude: a wide prior twist yields RMSE $1.37$ vs.\ $0.04$ for a backward-information-filter twist. Parallelism is essentially free; twist quality is the bottleneck}{figure.3}{}}
\@writefile{toc}{\contentsline {paragraph}{C3c. Lorenz-96: bootstrap baselines collapse, twisted smoother holds.}{8}{section*.15}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Twist quality ablation on LGSSM ($T=1000, D=1, N=256$). All twists hit DEER's $2$-iteration floor, so wall-clock speedup is constant; ESS and RMSE separate strong twists from weak ones by $> 30\times $.}}{9}{table.3}}
\newlabel{tab:twist-ablation}{{3}{9}{Twist quality ablation on LGSSM ($T=1000, D=1, N=256$). All twists hit DEER's $2$-iteration floor, so wall-clock speedup is constant; ESS and RMSE separate strong twists from weak ones by $> 30\times $}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Lorenz-63 parallel particle smoother ($T=2000, D=3, N=512$). Top row: state-component trajectories (true vs.\ smoothed). Middle row: twist-network ELBO training curve, per-step ESS, and 3D Lorenz attractor. Bottom row: the learned full-covariance twist's mean tracks the EKF smoother mean across $(x,y,z)$, capturing the cross-component coupling that a diagonal twist would miss.}}{9}{figure.4}}
\newlabel{fig:lorenz63}{{4}{9}{Lorenz-63 parallel particle smoother ($T=2000, D=3, N=512$). Top row: state-component trajectories (true vs.\ smoothed). Middle row: twist-network ELBO training curve, per-step ESS, and 3D Lorenz attractor. Bottom row: the learned full-covariance twist's mean tracks the EKF smoother mean across $(x,y,z)$, capturing the cross-component coupling that a diagonal twist would miss}{figure.4}{}}
