\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Scaling of the twisted parallel particle smoother. \textbf  {Left:} $T$ sweep on a $D=1$ LGSSM with $N=256$. \textbf  {Middle:} $D$ sweep at $T=4096, N=256$, comparing independent and coupled latent dynamics. \textbf  {Right:} $N$ sweep at $T=4096, D=1$. Speedup is sequential / parallel wall-clock; parallel and sequential RMSE agree to four significant figures throughout.}}{7}{table.1}}
\newlabel{tab:scaling-T}{{1}{7}{Scaling of the twisted parallel particle smoother. \textbf {Left:} $T$ sweep on a $D=1$ LGSSM with $N=256$. \textbf {Middle:} $D$ sweep at $T=4096, N=256$, comparing independent and coupled latent dynamics. \textbf {Right:} $N$ sweep at $T=4096, D=1$. Speedup is sequential / parallel wall-clock; parallel and sequential RMSE agree to four significant figures throughout}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Full-Jacobian DEER recovers coupled-dynamics performance ($T=4096$, $N=128$). The diagonal-Hutchinson approximation misses off-diagonal Jacobian entries and stalls at $7$ iterations; the full $(D,D)$-block scan converges in $2$ iterations at all tested dimensions and restores order-of-magnitude speedups.}}{7}{table.2}}
\newlabel{tab:fulljac}{{2}{7}{Full-Jacobian DEER recovers coupled-dynamics performance ($T=4096$, $N=128$). The diagonal-Hutchinson approximation misses off-diagonal Jacobian entries and stalls at $7$ iterations; the full $(D,D)$-block scan converges in $2$ iterations at all tested dimensions and restores order-of-magnitude speedups}{table.2}{}}
